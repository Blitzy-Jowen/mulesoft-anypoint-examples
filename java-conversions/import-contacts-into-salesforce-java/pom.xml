<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <!-- Empty on purpose: the repository-root pom.xml is the Mule examples aggregator, not this project's parent. -->
        <relativePath/>
    </parent>

    <groupId>com.mulesoft.examples</groupId>
    <artifactId>import-contacts-into-salesforce-java</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>import-contacts-into-salesforce-java</name>
    <description>Spring Boot 3.2 conversion of the Mule 3.8 example import-contacts-into-salesforce: a CSV file polled from a directory is mapped record by record into Salesforce Contacts and created through the SOAP Partner API.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Artefacts outside the Spring Boot 3.2.12 BOM -->
        <force-partner-api.version>65.0.0</force-partner-api.version>
        <wiremock.version>3.13.2</wiremock.version>

        <!-- Build plugins. The compiler, surefire, failsafe and enforcer properties reuse Boot's names with Boot's own values, so the parent's pluginManagement resolves the same versions. -->
        <maven-compiler-plugin.version>3.11.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.1.2</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.1.2</maven-failsafe-plugin.version>
        <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <spring-boot-maven-plugin.version>3.2.12</spring-boot-maven-plugin.version>
    </properties>

    <dependencies>
        <!-- No web starter: the original flow has no HTTP listener (spring.main.web-application-type: none). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            Salesforce SOAP Partner API (WSC 65.0.0; brings force-wsc, ST4 4.3, commons-beanutils 1.11.0).
            This block is shared verbatim by every Salesforce project.
            - force-wsc declares Jackson 2.18.4; the Spring Boot BOM resolves Jackson 2.15.4 instead (recorded in the
              root DECISIONS.md). The Partner API calls use WSC's own XML stack, not Jackson.
            - commons-logging is excluded because spring-jcl already provides the org.apache.commons.logging API;
              keeping both would put duplicate classes on the classpath.
        -->
        <!-- jackson-databind is not declared: force-wsc brings it at compile scope, which also serves the ST-2 test contract. A direct test-scoped declaration would remove it from the runtime classpath WSC needs. -->
        <dependency>
            <groupId>com.force.api</groupId>
            <artifactId>force-partner-api</artifactId>
            <version>${force-partner-api.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test scope only, never the application classpath: Boot 3.2 registers a TestRestTemplate for every
             @SpringBootTest(webEnvironment = RANDOM_PORT), including the ST-2 FixtureParityTest, and its context fails
             to load without spring-web. No server or servlet API comes with it, so test contexts stay non-web. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Shaded standalone artefact, so WireMock's Jetty and Jackson never clash with Boot's Jackson. Serves the SOAP stubs of the SC-15 client test and the ST-2 upstream replay. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>ban-jaxws-cxf</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>javax.xml.ws:*</exclude>
                                        <exclude>jakarta.xml.ws:*</exclude>
                                        <exclude>javax.jws:*</exclude>
                                        <exclude>jakarta.jws:*</exclude>
                                        <exclude>javax.xml:jaxws-api</exclude>
                                        <exclude>org.apache.cxf:*</exclude>
                                        <exclude>com.sun.xml.ws:*</exclude>
                                        <exclude>org.glassfish.metro:*</exclude>
                                    </excludes>
                                    <message>JAX-WS and CXF are banned in every converted project; SOAP is served and consumed through Spring WS, and Salesforce through WSC's own XML stack.</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <!-- Unit tier (mvn test): credential-free; live-sandbox *IT classes belong to failsafe only. No literal argLine, which would drop the JaCoCo agent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <!-- Declaring excludes replaces surefire's default, so nested classes stay excluded explicitly. -->
                        <exclude>**/*$*</exclude>
                    </excludes>
                    <!-- Every test context starts the scheduled ContactsFileTrigger; these system properties outrank
                         application.yml so tests never poll or move files under src/main/resources/input|output.
                         Tests needing their own directories override them with @DynamicPropertySource. -->
                    <systemPropertyVariables>
                        <contacts.input-dir>${project.build.directory}/test-contacts/input</contacts.input-dir>
                        <contacts.move-to-dir>${project.build.directory}/test-contacts/output</contacts.move-to-dir>
                        <contacts.polling-frequency>3600000</contacts.polling-frequency>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Tier 2B (mvn verify): live Salesforce test; ImportContactsToSfdcIT skips itself by assumption when src/test/resources/application-it.yml or a key is absent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <contacts.input-dir>${project.build.directory}/it-contacts/input</contacts.input-dir>
                        <contacts.move-to-dir>${project.build.directory}/it-contacts/output</contacts.move-to-dir>
                        <contacts.polling-frequency>3600000</contacts.polling-frequency>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Whole-project report, so total coverage is recorded beside the gated figure. -->
                    <execution>
                        <id>report</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Gate: LINE coverage >= 80% over service and mapper classes. The includes sit on the execution, because rule-level includes filter bundle names, not classes. -->
                    <execution>
                        <id>check</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>com/mulesoft/examples/import_contacts_into_salesforce/service/**</include>
                                <include>com/mulesoft/examples/import_contacts_into_salesforce/mapper/**</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>com.mulesoft.examples.import_contacts_into_salesforce.ImportContactsIntoSalesforceApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
