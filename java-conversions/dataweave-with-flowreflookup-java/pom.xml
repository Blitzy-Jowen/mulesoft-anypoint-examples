<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <!-- Empty on purpose: the repository-root pom.xml is the Mule examples aggregator, not this project's parent. -->
        <relativePath/>
    </parent>

    <groupId>com.mulesoft.examples</groupId>
    <artifactId>dataweave-with-flowreflookup-java</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>dataweave-with-flowreflookup-java</name>
    <description>Spring Boot 3.2 conversion of the Mule 3.8 example dataweave-with-flowreflookup: a CSV file polled from a directory becomes Salesforce Accounts, each enriched with a sales region looked up from its billing state.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Artefacts outside the Spring Boot 3.2.12 BOM -->
        <force-partner-api.version>65.0.0</force-partner-api.version>
        <wiremock.version>3.13.2</wiremock.version>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <dependencies>
        <!-- No web starter: the original flow has no HTTP listener (spring.main.web-application-type: none). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            Salesforce SOAP Partner API (WSC 65.0.0; brings force-wsc, ST4 4.3, commons-beanutils 1.11.0).
            Every Salesforce project pins the same WSC/Partner API 65.0.0; the commons-logging exclusion below is
              this project's own choice (some other Salesforce projects keep WSC's commons-logging).
            - force-wsc declares Jackson 2.18.4; the Spring Boot BOM resolves Jackson 2.15.4 instead (recorded in the
              root DECISIONS.md). The Partner API calls use WSC's own XML stack, not Jackson.
            - commons-logging is excluded because spring-jcl already provides the org.apache.commons.logging API;
              keeping both would put duplicate classes on the classpath.
        -->
        <dependency>
            <groupId>com.force.api</groupId>
            <artifactId>force-partner-api</artifactId>
            <version>${force-partner-api.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Test scope only; the application stays non-web. @SpringBootTest(webEnvironment = RANDOM_PORT), which the
            shared FixtureParityTest declares, registers Boot's TestRestTemplate factory, and without spring-web that
            factory cannot be introspected (NoClassDefFoundError: org/springframework/web/util/UriTemplateHandler), so
            the test context would fail to load. With it the context still starts as a non-web application.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Shaded standalone artefact, so WireMock's Jetty and Jackson never clash with Boot's Jackson. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Replaces the parent's @-delimiter filtering of application*.yml, so every resource is packaged byte-for-byte. -->
        <resources>
            <resource>
                <directory>${basedir}/src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>ban-jaxws-cxf</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>javax.xml.ws:*</exclude>
                                        <exclude>jakarta.xml.ws:*</exclude>
                                        <exclude>javax.jws:*</exclude>
                                        <exclude>jakarta.jws:*</exclude>
                                        <exclude>javax.xml:jaxws-api</exclude>
                                        <exclude>org.apache.cxf:*</exclude>
                                        <exclude>com.sun.xml.ws:*</exclude>
                                        <exclude>org.glassfish.metro:*</exclude>
                                    </excludes>
                                    <message>JAX-WS and CXF are banned in every converted project; SOAP is served and consumed through Spring WS, and Salesforce through WSC's own XML stack.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <!--
                Unit tier (mvn test): credential-free; live-sandbox *IT classes belong to failsafe only. No literal argLine,
                which would drop the JaCoCo agent.
                Every test context starts the scheduled CompaniesFileTrigger; these system properties outrank application.yml,
                so no test ever polls or moves files under src/main/resources. Tests needing their own directories override
                them with @DynamicPropertySource.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <!-- Declaring excludes replaces surefire's default, so nested classes stay excluded explicitly. -->
                        <exclude>**/*$*</exclude>
                    </excludes>
                    <systemPropertyVariables>
                        <companies.input-dir>${project.build.directory}/test-companies/input</companies.input-dir>
                        <companies.move-to-dir>${project.build.directory}/test-companies/output</companies.move-to-dir>
                        <companies.polling-frequency>3600000</companies.polling-frequency>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Tier 2B (mvn verify): live Salesforce tests; each *IT skips itself by assumption when src/test/resources/application-it.yml or a key is absent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.1.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <companies.input-dir>${project.build.directory}/it-companies/input</companies.input-dir>
                        <companies.move-to-dir>${project.build.directory}/it-companies/output</companies.move-to-dir>
                        <companies.polling-frequency>3600000</companies.polling-frequency>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Whole-project report, so total coverage is recorded beside the gated figure. -->
                    <execution>
                        <id>report</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Gate: LINE coverage >= 80% over service and mapper classes. The includes sit on the execution, because rule-level includes filter bundle names, not classes. -->
                    <execution>
                        <id>check</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>com/mulesoft/examples/dataweave_with_flowreflookup/service/**</include>
                                <include>com/mulesoft/examples/dataweave_with_flowreflookup/mapper/**</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.2.12</version>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>com.mulesoft.examples.dataweave_with_flowreflookup.DataweaveWithFlowreflookupApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
