<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone project: the empty relativePath keeps Maven from resolving the repository-root Mule reactor. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <groupId>com.mulesoft.examples</groupId>
    <artifactId>importing-an-email-attachment-using-the-IMAP-connector-java</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>importing-an-email-attachment-using-the-IMAP-connector-java</name>
    <description>Spring Boot conversion of the Mule 3.8 example importing-an-email-attachment-using-the-IMAP-connector: IMAPS poller, CSV attachment to orders XML file.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- The only main dependency. No web starter: the original flow has no HTTP listener
             (spring.main.web-application-type: none). Angus Mail supplies the imaps Store the poller opens. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- GreenMail (IMAPS + SMTP) replaces the Gmail account the original integration test mailed through. The
             starter's org.eclipse.angus:jakarta.mail already bundles the jakarta.mail API with Angus, so GreenMail's
             separate API jar is excluded to keep a single copy of every jakarta.mail class on the test classpath. -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>2.1.14</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.mail</groupId>
                    <artifactId>jakarta.mail-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- WireMock, Awaitility and Jackson form the test-classpath contract of the shared FixtureParityTest replay
             engine; Jackson is declared because no starter of this project brings it, and the shaded WireMock
             edition cannot clash with the Boot-managed Jackson. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test scope only, so the application stays without any web stack: FixtureParityTest runs as
             @SpringBootTest(webEnvironment = RANDOM_PORT), and Boot 3.2's TestRestTemplate customizer for that mode
             cannot load its context without spring-web classes. The shaded WireMock servlet API keeps classpath
             deduction at NONE, and application.yml pins spring.main.web-application-type: none. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>enforce-banned-dependencies</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>javax.xml.ws:*</exclude>
                                        <exclude>jakarta.xml.ws:*</exclude>
                                        <exclude>javax.jws:*</exclude>
                                        <exclude>jakarta.jws:*</exclude>
                                        <exclude>javax.xml:jaxws-api</exclude>
                                        <exclude>org.apache.cxf:*</exclude>
                                        <exclude>com.sun.xml.ws:*</exclude>
                                        <exclude>org.glassfish.metro:*</exclude>
                                    </excludes>
                                    <message>JAX-WS and CXF (APIs and providers) are banned in every converted project; SOAP is implemented with Spring WS only.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>

            <!-- *IT classes are reserved for failsafe live-sandbox tests, which only connector projects have.
                 No literal argLine here: it would replace the JaCoCo agent that prepare-agent sets. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <!-- Declaring excludes replaces surefire's default, so nested classes stay excluded explicitly. -->
                        <exclude>**/*$*</exclude>
                    </excludes>
                    <systemPropertyVariables>
                        <!-- Every test context, FixtureParityTest included, loads application-test.yml: GreenMail
                             host, ports and users, the held-back scheduled poll and a target/ output directory. -->
                        <spring.profiles.active>test</spring.profiles.active>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <!-- The class filter sits on the execution: inside a BUNDLE rule, includes would match bundle names, not classes. -->
                        <configuration>
                            <includes>
                                <include>com/mulesoft/examples/importing_an_email_attachment_using_the_imap_connector/service/**</include>
                                <include>com/mulesoft/examples/importing_an_email_attachment_using_the_imap_connector/mapper/**</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.2.12</version>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>com.mulesoft.examples.importing_an_email_attachment_using_the_imap_connector.ImportingAnEmailAttachmentUsingTheIMAPConnectorApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
